{
  "name": "dasha-agent",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "description": "DaShaAgent OS v3.0 —— 可插拔的智能体操作系统",
  "scripts": {
    "start": "tsx --max-semi-space-size=512 --max-old-space-size=4096 --expose-gc server/src/unified.ts",
    "dev": "tsx watch server/src/unified.ts",
    "os": "tsx server/src/index.ts",
    "os:dev": "tsx watch server/src/index.ts",
    "typecheck": "tsc --noEmit",
    "verify": "tsx -e \"import('./server/src/git/verifyGate.ts').then(m=>m.runVerificationGate()).then(r=>{console.log(r.report);process.exit(r.pass?0:1)}).catch(e=>{console.error(e);process.exit(2)})\"",
    "test": "tsx tests/run.ts",
    "test:unit": "node tests/unit_all.cjs",
    "test:stop": "tsx tests/stop.ts",
    "cli": "tsx server/src/api/cli.ts",
    "cli:start": "tsx server/src/api/cli.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@google/generative-ai": "^0.24.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "better-sqlite3": "^13.0.2",
    "cors": "^2.8.6",
    "dockerode": "^5.0.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "openai": "^7.4.0",
    "playwright": "^1.62.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.2",
    "@types/ws": "^8.18.1",
    "tsx": "^4.19.2",
    "typescript": "^7.0.2"
  }
}
