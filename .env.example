# ============================================================
#  DaShaAgent OS v3.0  —  环境变量模板
#  用法：复制为 .env 后按需填写。所有项都有安全默认值，可全部留空。
# ============================================================

# ==================
# LLM PROVIDERS      （Phase 2 - Step 1 §二）
# ==================
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
DEEPSEEK_API_KEY=

# DEFAULT MODEL
DEFAULT_LLM=openai
OPENAI_MODEL=gpt-5
CLAUDE_MODEL=claude-sonnet
GEMINI_MODEL=gemini-pro
LOCAL_MODEL=qwen2.5

# LLM 选择（可选，留空则沿用下方 AH_PROVIDER 的桥接结果）
# provider: openai | claude | gemini | local
LLM_PROVIDER=
LLM_MODEL=

# 各家默认模型的旧别名（仅在未通过 CLAUDE_MODEL / GEMINI_MODEL 指定时生效）
ANTHROPIC_MODEL=claude-sonnet-4
GOOGLE_MODEL=gemini-2.5-pro

# 启动自检（Step 3 §九）：auto=仅占位态执行(零开销) | 1=强制 | 0=关闭
LLM_SELFTEST=auto
LLM_SELFTEST_PROVIDER=openai

# ------------------------------------------------------------
# SYSTEM
# ------------------------------------------------------------
AGENT_NAME=DaShaAgent
# mode: autonomous | assistant
AGENT_MODE=autonomous

# ------------------------------------------------------------
# MEMORY
# ------------------------------------------------------------
MEMORY_ENABLED=true
# type: local | vector
MEMORY_TYPE=local

# ------------------------------------------------------------
# SANDBOX（权限配置。Phase 3 - Step 1 接入真实沙箱前仅为声明）
# ------------------------------------------------------------
SANDBOX_ENABLED=true
SANDBOX_ALLOW_SHELL=false
SANDBOX_ALLOW_NETWORK=false

# ============================================================
#  以下为 V1/V2 既有运行时变量（server/src/config/system.ts）
#  控制 HTTP 服务、本地模型端点与主循环护栏，保持向后兼容。
# ============================================================

# HTTP 服务端口（unified.ts 生产入口实际监听此端口）
AH_CONTROL_PORT=3001
# 以下为 V1/V2 既有运行时变量（保持向后兼容）
AH_PORT=8787

# 模型来源：ollama | cloud | mock
AH_PROVIDER=ollama

# Ollama 本地模型
AH_OLLAMA_BASE=http://127.0.0.1:11434
AH_OLLAMA_MODEL=
AH_OLLAMA_EMBED=

# 云端（OpenAI 兼容协议）
AH_CLOUD_BASE=https://api.openai.com/v1
AH_CLOUD_KEY=
AH_CLOUD_MODEL=gpt-4o-mini

# Agent 主循环最大迭代次数
AH_MAX_ITER=12

# 微信 (OpenClaw) 通道：1 开启 / 0 关闭
AH_WECHAT=0
